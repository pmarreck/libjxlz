#!/usr/bin/env bash
set -uo pipefail
set -E

trap 'echo "ERR at ${BASH_SOURCE[0]}:${LINENO}: $BASH_COMMAND" >&2' ERR

source ./tests/lib/zig_runner.bash

run() {
  "$@" || {
    echo "FAILED: $*" >&2
    exit 1
  }
}

optimize="ReleaseFast"
if [[ "${1:-}" == "debug" ]]; then
  optimize="Debug"
  shift
fi

if [[ "$optimize" != "ReleaseFast" ]]; then
  run run_project_zig build "-Doptimize=$optimize" "$@"
elif command -v nix >/dev/null 2>&1; then
  out="$(nix build --print-out-paths "$@")" || {
    echo "FAILED: nix build $*" >&2
    exit 1
  }
  mkdir -p zig-out/bin
  if [[ ! -d "$out/bin" ]]; then
    echo "FAILED: expected $out/bin to exist" >&2
    exit 1
  fi
  run cp -R "$out/bin/." zig-out/bin/
else
  run run_project_zig build "-Doptimize=$optimize" "$@"
fi
