#!/usr/bin/env bash
set -u

ERRORS=0
SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"

echo "=== Zig unit tests ==="
if ! nix build ".#checks.${SYSTEM}.test" 2>&1; then
	ERRORS=$((ERRORS + 1))
fi

if [ -d tests/cli ]; then
	echo "=== CLI tests ==="
	for t in tests/cli/*.sh; do
		if ! nix develop -c bash "$t"; then
			ERRORS=$((ERRORS + 1))
		fi
	done
fi

if [ "$ERRORS" -gt 0 ]; then
	echo "FAILED: $ERRORS test suite(s) failed"
fi
exit "$ERRORS"
