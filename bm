#!/usr/bin/env bash
set -u

if [ "${1-}" = "--inside-nix" ]; then
	shift
elif [ -z "${IN_NIX_SHELL-}" ]; then
	exec nix develop -c bash "$0" --inside-nix "$@"
fi

SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"
RUNS=8
WARMUP=2
FULL_REPEAT=4
LARGE_REPEAT=96
ENCODE_REPEAT=1
THRESHOLD_PCT=5
HISTORY="tests/benchmark/public_api_decode_history.tsv"
ENCODE_HISTORY="tests/benchmark/modular_encode_codestream_history.tsv"
DEQUANT_HISTORY="tests/benchmark/dequant_ensure_computed_history.tsv"
# Flip to 1 once DCT256 GetQuantWeights or a public-C VarDCT decode vs
# libjxl is worth quoting. Until then the harness is built and tested
# (checksum smoke) but `./bm` does not seed the TSV.
DEQUANT_READY=0
DEQUANT_REPEAT=64
TMP_BM_DIR="$(mktemp -d "${TMPDIR}/libjxlz-bm-public-api.XXXXXX")" || exit 1
OUR_BIN="${TMP_BM_DIR}/decode_public_api_libjxlz"
REF_BIN="${TMP_BM_DIR}/decode_public_api_libjxl_ref"
ENCODE_BIN="${TMP_BM_DIR}/bench_modular_encode_codestream"
DEQUANT_BIN="${TMP_BM_DIR}/bench_dequant_ensure_computed"
CSV_OUT="${TMP_BM_DIR}/hyperfine.csv"
ENCODE_CSV_OUT="${TMP_BM_DIR}/hyperfine_encode.csv"
DEQUANT_CSV_OUT="${TMP_BM_DIR}/hyperfine_dequant.csv"
OUR_COMPILE_LOG="${TMP_BM_DIR}/compile_ours.log"
REF_COMPILE_LOG="${TMP_BM_DIR}/compile_ref.log"
ENCODE_COMPILE_LOG="${TMP_BM_DIR}/compile_encode.log"
DEQUANT_COMPILE_LOG="${TMP_BM_DIR}/compile_dequant.log"
REF_BUILD_DIR="${LIBJXLZ_BENCH_REF_BUILD:-build-cpp-bm}"
PACKAGE_OUT=""

# The optimize mode packages.releasefast is built with. Benchmark rows are only ever
# compared against rows from the same mode and machine: mixing a ReleaseSafe
# measurement into a ReleaseFast series produces a step change that reads as a
# regression but is really a different binary. All rows recorded before
# 2026-08-01 predate the ReleaseSafe switch and are backfilled as ReleaseFast.
BUILD_MODE="ReleaseFast"

# Stable per-machine identifier so a new machine seeds its own baseline instead
# of failing the build against someone else's timings. Override the host portion
# with LIBJXLZ_BENCH_MACHINE when a machine is renamed.
machine_id() {
	local host arch cpu
	host="${LIBJXLZ_BENCH_MACHINE:-$(uname -n)}"
	arch="$(uname -m)"
	cpu="$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo 2>/dev/null)"
	if [ -z "${cpu}" ]; then
		cpu="$(sysctl -n machdep.cpu.brand_string 2>/dev/null)"
	fi
	if [ -z "${cpu}" ]; then
		cpu="unknown-cpu"
	fi
	printf '%s|%s|%s' "${host}" "${arch}" "${cpu}" | sha256sum | cut -c1-12
}
MACHINE_ID="$(machine_id)"

# Benchmarking a debug build wastes hours and produces meaningless numbers, and
# MUTE_DEBUG_STATUS would hide the very banner that warns about it. Refuse both.
assert_not_debug_build() {
	if [ -n "${MUTE_DEBUG_STATUS-}" ]; then
		echo "refusing to benchmark with MUTE_DEBUG_STATUS set: it suppresses the debug-build banner" >&2
		exit 1
	fi
	local banner
	banner="$("${PACKAGE_OUT}/bin/djxlz" --about 2>&1 >/dev/null)"
	if printf '%s' "${banner}" | grep -q 'DEBUG BUILD'; then
		echo "refusing to benchmark a debug build of packages.releasefast" >&2
		exit 1
	fi
}

mkdir -p "${TMP_BM_DIR}"

compile_ours() {
	if ! PACKAGE_OUT="$(nix build --no-link --print-out-paths ".#packages.${SYSTEM}.releasefast" 2>"${OUR_COMPILE_LOG}")"; then
		cat "${OUR_COMPILE_LOG}"
		exit 1
	fi
	assert_not_debug_build
	if ! clang \
		-std=c11 \
		-O3 \
		-Wall -Wextra -Werror \
		-Iinclude \
		-Ilib/include \
		tests/benchmark/decode_public_api.c \
		"${PACKAGE_OUT}/lib/libjxlz_capi.a" \
		$(pkg-config --libs libbrotlienc libbrotlidec libbrotlicommon) \
		-o "${OUR_BIN}" >"${OUR_COMPILE_LOG}" 2>&1; then
		cat "${OUR_COMPILE_LOG}"
		exit 1
	fi
}

compile_ref() {
	REF_LIB="$(fd '^libjxl(\..*)?\.(dylib|so|a)$' "${REF_BUILD_DIR}/lib" -t f 2>/dev/null | head -n 1)"
	if [ -z "${REF_LIB}" ]; then
		cmake -S . -B "${REF_BUILD_DIR}" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF >/dev/null
		cmake --build "${REF_BUILD_DIR}" >/dev/null
	fi

	REF_LIB="$(fd '^libjxl(\..*)?\.(dylib|so|a)$' "${REF_BUILD_DIR}/lib" -t f 2>/dev/null | head -n 1)"
	if [ -z "${REF_LIB}" ]; then
		echo "reference libjxl build not found under build-cpp/lib" >&2
		exit 1
	fi
	REF_LIB_DIR="$(cd "$(dirname "${REF_LIB}")" && pwd)"
	REF_ROOT_DIR="$(cd "${REF_LIB_DIR}/.." && pwd)"
	REF_EXTRA=()
	if [[ "$REF_LIB" == *.a ]]; then
		REF_EXTRA=("${REF_LIB_DIR}/libjxl_cms.a" "${REF_ROOT_DIR}/third_party/highway/libhwy.a")
		if [ "$(uname -s)" = Darwin ]; then REF_EXTRA+=(-lc++); else REF_EXTRA+=(-lstdc++); fi
	fi

	if ! clang \
		-std=c11 \
		-O3 \
		-Wall -Wextra -Werror \
		-Iinclude \
		-Ilib/include \
		-I"${REF_ROOT_DIR}/lib/include" \
		tests/benchmark/decode_public_api.c \
		"${REF_LIB}" \
		"${REF_EXTRA[@]}" \
		$(pkg-config --libs libbrotlienc libbrotlidec libbrotlicommon lcms2) -lm \
		-Wl,-rpath,"${REF_LIB_DIR}" \
		-Wl,-rpath,"${REF_ROOT_DIR}/third_party/brotli" \
		-o "${REF_BIN}" >"${REF_COMPILE_LOG}" 2>&1; then
		cat "${REF_COMPILE_LOG}"
		exit 1
	fi
}

compile_encode_codestream() {
	ENCODE_BIN="${PACKAGE_OUT}/bin/bench_modular_encode_codestream"
	if [ ! -x "${ENCODE_BIN}" ]; then
		echo "encode benchmark binary not found at ${ENCODE_BIN}" >"${ENCODE_COMPILE_LOG}"
		cat "${ENCODE_COMPILE_LOG}"
		exit 1
	fi
}

compile_dequant() {
	DEQUANT_BIN="${PACKAGE_OUT}/bin/bench_dequant_ensure_computed"
	if [ ! -x "${DEQUANT_BIN}" ]; then
		echo "dequant benchmark binary not found at ${DEQUANT_BIN}" >"${DEQUANT_COMPILE_LOG}"
		cat "${DEQUANT_COMPILE_LOG}"
		exit 1
	fi
}

benchmark_scenario() {
	SCENARIO_NAME="$1"
	REPEAT_COUNT="$2"
	shift 2
	FILES=("$@")

	hyperfine \
		--style basic \
		--warmup "${WARMUP}" \
		--runs "${RUNS}" \
		--export-csv "${CSV_OUT}" \
		-N \
		-n libjxlz_capi \
		-n libjxl_ref \
		"${OUR_BIN} --repeat ${REPEAT_COUNT} ${FILES[*]}" \
		"${REF_BIN} --repeat ${REPEAT_COUNT} ${FILES[*]}"

	OUR_MEAN="$(awk -F, 'NR==2 { gsub(/"/, "", $2); print $2 }' "${CSV_OUT}")"
	REF_MEAN="$(awk -F, 'NR==3 { gsub(/"/, "", $2); print $2 }' "${CSV_OUT}")"
	OUR_CPU="$(awk -F, 'NR==2 { print $5 + $6 }' "${CSV_OUT}")"
	REF_CPU="$(awk -F, 'NR==3 { print $5 + $6 }' "${CSV_OUT}")"
	printf '{"timestamp":"%s","commit":"%s","kernel_sha256":"%s","machine":"%s","mode":"%s","scenario":"%s","repeat":%s,"our_wall_s":%s,"ref_wall_s":%s,"our_cpu_s":%s,"ref_cpu_s":%s}\n' \
		"$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$(git rev-parse HEAD)" "$(sha256sum src/lib/base/soft_float.zig | cut -d ' ' -f 1)" "$MACHINE_ID" "$BUILD_MODE" "$SCENARIO_NAME" "$REPEAT_COUNT" "$OUR_MEAN" "$REF_MEAN" "$OUR_CPU" "$REF_CPU" >> tests/benchmark/public_api_cpu_history.jsonl
	SPEEDUP="$(awk -v our="${OUR_MEAN}" -v ref="${REF_MEAN}" 'BEGIN { printf "%.6f", ref / our }')"
	STAMP="$(TZ=America/New_York date '+%Y-%m-%d %I:%M:%S %p %Z')"

	if [ ! -f "${HISTORY}" ]; then
		printf 'timestamp_est\tscenario\trepeat\tour_mean_s\tref_mean_s\tref_over_our\tbuild_mode\tmachine_id\n' > "${HISTORY}"
	fi

	# Compare only against this machine's last run in this build mode. A machine
	# or mode with no prior row seeds its baseline and passes, so a new host never
	# breaks the build against timings it never produced.
	PREV_LINE="$(awk -F '\t' -v scenario="${SCENARIO_NAME}" -v mode="${BUILD_MODE}" -v machine="${MACHINE_ID}" \
		'NR > 1 && $2 == scenario && $7 == mode && $8 == machine { last = $0 } END { print last }' "${HISTORY}")"
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${STAMP}" "${SCENARIO_NAME}" "${REPEAT_COUNT}" "${OUR_MEAN}" "${REF_MEAN}" "${SPEEDUP}" "${BUILD_MODE}" "${MACHINE_ID}" >> "${HISTORY}"

	printf '%s: libjxlz=%ss libjxl=%ss ref/our=%sx\n' "${SCENARIO_NAME}" "${OUR_MEAN}" "${REF_MEAN}" "${SPEEDUP}"

	if [ -n "${PREV_LINE}" ]; then
		PREV_OUR="$(printf '%s\n' "${PREV_LINE}" | awk -F '\t' '{ print $4 }')"
		DELTA_PCT="$(awk -v prev="${PREV_OUR}" -v cur="${OUR_MEAN}" 'BEGIN { if (prev == 0) print 0; else printf "%.2f", ((cur - prev) / prev) * 100.0 }')"
		ABS_DELTA="$(awk -v delta="${DELTA_PCT}" 'BEGIN { if (delta < 0) delta = -delta; printf "%.2f", delta }')"
		if awk -v delta="${ABS_DELTA}" -v threshold="${THRESHOLD_PCT}" 'BEGIN { exit !(delta >= threshold) }'; then
			echo "PERF SHIFT: ${SCENARIO_NAME} changed by ${DELTA_PCT}% vs previous recorded run" >&2
			exit 1
		fi
	fi
}

benchmark_encode_codestream() {
	SCENARIO_NAME="$1"
	hyperfine \
		--style basic \
		--warmup "${WARMUP}" \
		--runs "${RUNS}" \
		--export-csv "${ENCODE_CSV_OUT}" \
		-N \
		-n modular_encode_codestream \
		"${ENCODE_BIN} --repeat ${ENCODE_REPEAT}"

	OUR_MEAN="$(awk -F, 'NR==2 { gsub(/"/, "", $2); print $2 }' "${ENCODE_CSV_OUT}")"
	STAMP="$(TZ=America/New_York date '+%Y-%m-%d %I:%M:%S %p EST')"
	# Same rule as the decode series: only this machine, only this build mode.
	PREV_LINE="$(awk -F '\t' -v scenario="${SCENARIO_NAME}" -v mode="${BUILD_MODE}" -v machine="${MACHINE_ID}" \
		'NR > 1 && $2 == scenario && $5 == mode && $6 == machine { last = $0 } END { print last }' "${ENCODE_HISTORY}")"

	if [ ! -f "${ENCODE_HISTORY}" ]; then
		printf 'timestamp_est\tscenario\trepeat\tour_mean_s\tbuild_mode\tmachine_id\n' > "${ENCODE_HISTORY}"
	fi

	printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
		"${STAMP}" \
		"${SCENARIO_NAME}" \
		"${ENCODE_REPEAT}" \
		"${OUR_MEAN}" \
		"${BUILD_MODE}" \
		"${MACHINE_ID}" >> "${ENCODE_HISTORY}"

	printf '%s: modular_encode_codestream=%ss\n' "${SCENARIO_NAME}" "${OUR_MEAN}"

	if [ -n "${PREV_LINE}" ]; then
		PREV_OUR="$(printf '%s\n' "${PREV_LINE}" | awk -F '\t' '{ print $4 }')"
		DELTA_PCT="$(awk -v prev="${PREV_OUR}" -v cur="${OUR_MEAN}" 'BEGIN { if (prev == 0) print 0; else printf "%.2f", ((cur - prev) / prev) * 100.0 }')"
		ABS_DELTA="$(awk -v delta="${DELTA_PCT}" 'BEGIN { if (delta < 0) delta = -delta; printf "%.2f", delta }')"
		if awk -v delta="${ABS_DELTA}" -v threshold="${THRESHOLD_PCT}" 'BEGIN { exit !(delta >= threshold) }'; then
			echo "PERF SHIFT: ${SCENARIO_NAME} changed by ${DELTA_PCT}% vs previous recorded run" >&2
			exit 1
		fi
	fi
}

benchmark_dequant_ensure_computed() {
	SCENARIO_NAME="$1"
	# Scaling-ratio is machine-independent and does not seed history.
	# Run it as soon as the kernel exists; constant-factor TSV waits.
	if ! "${DEQUANT_BIN}" --scaling; then
		echo "PERF SHIFT: ${SCENARIO_NAME} GetQuantWeights growth exceeded the linear gate" >&2
		exit 1
	fi
	if [ "${DEQUANT_READY}" -eq 0 ]; then
		echo "${SCENARIO_NAME}: waiting until the kernel can impress (DCT256 / public VarDCT decode vs libjxl). Harness is built; ${DEQUANT_HISTORY} unseeded."
		return 0
	fi
	hyperfine \
		--style basic \
		--warmup "${WARMUP}" \
		--runs "${RUNS}" \
		--export-csv "${DEQUANT_CSV_OUT}" \
		-N \
		-n dequant_ensure_computed \
		"${DEQUANT_BIN} --repeat ${DEQUANT_REPEAT}"

	OUR_MEAN="$(awk -F, 'NR==2 { gsub(/"/, "", $2); print $2 }' "${DEQUANT_CSV_OUT}")"
	STAMP="$(TZ=America/New_York date '+%Y-%m-%d %I:%M:%S %p EST')"
	PREV_LINE="$(awk -F '\t' -v scenario="${SCENARIO_NAME}" -v mode="${BUILD_MODE}" -v machine="${MACHINE_ID}" \
		'NR > 1 && $2 == scenario && $5 == mode && $6 == machine { last = $0 } END { print last }' "${DEQUANT_HISTORY}")"

	if [ ! -f "${DEQUANT_HISTORY}" ]; then
		printf 'timestamp_est\tscenario\trepeat\tour_mean_s\tbuild_mode\tmachine_id\n' > "${DEQUANT_HISTORY}"
	fi

	printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
		"${STAMP}" \
		"${SCENARIO_NAME}" \
		"${DEQUANT_REPEAT}" \
		"${OUR_MEAN}" \
		"${BUILD_MODE}" \
		"${MACHINE_ID}" >> "${DEQUANT_HISTORY}"

	printf '%s: dequant_ensure_computed=%ss\n' "${SCENARIO_NAME}" "${OUR_MEAN}"

	if [ -n "${PREV_LINE}" ]; then
		PREV_OUR="$(printf '%s\n' "${PREV_LINE}" | awk -F '\t' '{ print $4 }')"
		DELTA_PCT="$(awk -v prev="${PREV_OUR}" -v cur="${OUR_MEAN}" 'BEGIN { if (prev == 0) print 0; else printf "%.2f", ((cur - prev) / prev) * 100.0 }')"
		ABS_DELTA="$(awk -v delta="${DELTA_PCT}" 'BEGIN { if (delta < 0) delta = -delta; printf "%.2f", delta }')"
		if awk -v delta="${ABS_DELTA}" -v threshold="${THRESHOLD_PCT}" 'BEGIN { exit !(delta >= threshold) }'; then
			echo "PERF SHIFT: ${SCENARIO_NAME} changed by ${DELTA_PCT}% vs previous recorded run" >&2
			exit 1
		fi
	fi
}

benchmark_arithmetic() {
	local history raw recorded numeric output status stamp commit
	history=tests/benchmark/arithmetic_history.jsonl
	raw="${TMP_BM_DIR}/arithmetic.jsonl"
	recorded="${TMP_BM_DIR}/arithmetic-recorded.jsonl"
	: > "$raw"
	for numeric in Fixed f32 f64; do
		output="$("${PACKAGE_OUT}/bin/bench_fixed_arithmetic" "$numeric" 4096 32768)" || return 1
		printf '%s\n' "$output" >> "$raw"
	done
	stamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
	commit="$(git rev-parse HEAD)"
	awk -v stamp="$stamp" -v commit="$commit" -v machine="$MACHINE_ID" -v target="$SYSTEM" \
		'{ sub(/^\{/, "{\"timestamp\":\"" stamp "\",\"commit\":\"" commit "\",\"machine\":\"" machine "\",\"target\":\"" target "\",\"mode\":\"ReleaseFast\","); print }' "$raw" > "$recorded"
	[ -f "$history" ] || : > "$history"
	awk -f tests/benchmark/arithmetic_history.awk "$history" "$recorded"
	status=$?
	if [ "$status" -eq 2 ]; then return 1; fi
	cat "$recorded" >> "$history"
	cat "$raw"
	return "$status"
}

compile_ours
benchmark_arithmetic || exit 1
compile_ref
compile_encode_codestream
compile_dequant

FULL_FILES=(
	src/lib/testdata/lossless_4x4.jxl
	src/lib/testdata/lossless_16x16.jxl
	src/lib/testdata/lossless_64x64.jxl
	src/lib/testdata/lossless_300x200.jxl
	src/lib/testdata/lossless_600x10_multisection.jxl
	src/lib/testdata/lossless_600x300_multigroup_rgb.jxl
)
LARGE_FILE=(src/lib/testdata/lossless_600x300_multigroup_rgb.jxl)

benchmark_scenario full_corpus "${FULL_REPEAT}" "${FULL_FILES[@]}"
benchmark_scenario large_multigroup_rgb "${LARGE_REPEAT}" "${LARGE_FILE[@]}"
"${PACKAGE_OUT}/bin/bench_fixed_arithmetic" --vardct-fixture > "${TMP_BM_DIR}/vardct-272x19.jxl" || exit 1
benchmark_scenario vardct_272x19 256 "${TMP_BM_DIR}/vardct-272x19.jxl"
benchmark_encode_codestream modular_encode_codestream_rgb_multigroup
benchmark_dequant_ensure_computed dequant_ensure_computed_dct8_library
